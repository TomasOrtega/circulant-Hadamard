{
  "name": "circulant-hadamard-website",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.3",
    "node": ">=24"
  },
  "scripts": {
    "build:css": "tailwindcss --input styles.css --output dist/styles.css --minify",
    "build:nodes": "bun run build-nodes.jsx",
    "build:player": "bun build video-player.js --target browser --format iife --outfile dist/video-player.js --minify",
    "test": "bun test"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "rehype-mathjax": "7.1.0",
    "rehype-stringify": "10.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/sometype-mono": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  }
}
